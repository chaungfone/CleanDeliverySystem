# ---- PRODUCTION (sample/placeholder - DO NOT commit real secrets) ----
PROJECT_NAME="Clean Water Delivery Management System"
API_V1_PREFIX="/api/v1"
DEBUG=False

# Supabase Credentials (CRITICAL - replace with production values)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-production-service-role-key"
SUPABASE_JWT_SECRET="your-production-jwt-secret"

# CORS: explicit allow-list (no wildcard). Uses CORS_ORIGINS_JSON (validated alias).
CORS_ORIGINS_JSON=["https://admin.yourcompany.com", "https://yourcompany.com", "capacitor://localhost"]

# Sentry (Optional)
SENTRY_DSN="https://your-sentry-dsn@ingest.sentry.io/0000000"

# SMS & Notifications (Optional)
SMS_BASE_URL="https://api.sms-provider.com"
SMS_API_KEY="your-api-key"
SMS_SENDER="your-sender-id"
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="your-token"

# Redis (Optional, for persistent rate limiting across instances)
# REDIS_URL="redis://your-redis:6379/0"