# ---- STAGING (sample/placeholder - DO NOT commit real secrets) ----
PROJECT_NAME="Clean Water Delivery Management System"
API_V1_PREFIX="/api/v1"
DEBUG=False

# Supabase Credentials (CRITICAL - replace with staging values)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-staging-service-role-key"
SUPABASE_JWT_SECRET="your-staging-jwt-secret"

# CORS: explicit whitelist for staging (wildcard rejected when DEBUG=False)
CORS_ORIGINS_JSON=["http://localhost:3005", "https://staging-admin.yourcompany.com"]

# Sentry (Optional)
SENTRY_DSN="https://your-sentry-dsn@ingest.sentry.io/0000000"

# SMS & Notifications (Optional)
SMS_BASE_URL="https://api.sms-provider.com"
SMS_API_KEY="your-api-key"
SMS_SENDER="your-sender-id"
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="your-token"

# Redis (Optional, for persistent rate limiting). If unreachable the app
# gracefully falls back to in-memory storage (with a startup warning).
REDIS_URL="redis://localhost:6379/0"

# Database connection strings
# Use pooled URL (pgBouncer) for runtime application connections and DIRECT_URL
# for direct DB connections (migrations/tools) targeting the direct DB port 5432.
# Set these in staging to your staging Supabase/Postgres connection strings.
