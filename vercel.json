{
  "version": 2,
  "installCommand": "pwd; ls -la; (cd web-dashboard && npm install)",
  "buildCommand": "(cd web-dashboard && npm run build) && echo '---BUILT---' && ls -la web-dashboard/dist && echo '---API FILES---' && ls -la api",
  "outputDirectory": "web-dashboard/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3.2.0",
      "includeFiles": "backend/**,requirements.txt,runtime.txt"
    }
  },
  "rewrites": [
    { "source": "/api/healthz", "destination": "/api" },
    { "source": "/api/v1/:path((?!\\.).*)", "destination": "/api" },
    { "source": "/api/:path((?!\\.).*)", "destination": "/api" },
    { "source": "/((?!api/?|assets/?|assets/|favicon\\.ico|robots\\.txt|__vercel-insights).*)", "destination": "/index.html" }
  ]
}
