{
  "version": 2,
  "installCommand": "cd web-dashboard && npm install",
  "buildCommand": "cd web-dashboard && npm run build",
  "outputDirectory": "web-dashboard/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
