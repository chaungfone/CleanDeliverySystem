{
  "builds": [
    {
      "src": "web-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.10"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/app/main.py" },
    { "src": "/(.*)", "dest": "/web-dashboard/dist/$1" },
    { "src": "/(.*)", "dest": "/web-dashboard/dist/index.html" }
  ]
}
